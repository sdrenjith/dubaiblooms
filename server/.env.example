NODE_ENV=development
PORT=5000

# Local MongoDB (adjust host/db name as needed)
MONGODB_URI=mongodb://127.0.0.1:27017/dubaiblooms

# Use a long random value; >=32 chars required when NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars-for-prod
JWT_EXPIRES_IN=7d

# Browser origins allowed by CORS (comma-separated in production). Dev: optional; include localhost dev URL if needed.
# Example production: https://dubaiblooms.ae,https://www.dubaiblooms.ae
CORS_ORIGIN=http://localhost:5173

# Optional; default 3000 requests per 15 minutes per IP (production only)
API_RATE_LIMIT_MAX=3000
